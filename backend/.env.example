# Variables de entorno del backend.
# Copia este archivo como backend/.env y completa GEMINI_API_KEY.
# config.py lo carga automáticamente; las variables ya definidas en el entorno tienen prioridad.
# Nunca subas backend/.env al repositorio (está en .gitignore).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_S=30
# Opcional. Por defecto: backend/insightdesk.db (ruta absoluta, sin importar desde dónde se lance uvicorn).
# DATABASE_URL=sqlite:///C:/ruta/a/insightdesk.db
